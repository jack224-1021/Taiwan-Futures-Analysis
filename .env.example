# ==============================================================================
# 台股個股期貨強勢排名與盤中決策終端 - 環境設定檔 (.env.example)
# 請複製本檔案為 .env 並填入實際 API 金鑰。
# ==============================================================================

# 1. 資料模式開關 (live: 使用 Shioaji 正式環境真實行情 | mock: 使用模擬資料)
# 注意：在 live 模式下，若登入或訂閱失敗，系統嚴禁自動退回 mock，將在畫面明確顯示錯誤與原因。
DATA_MODE=live

# 2. 永豐金證券 Shioaji API (正式環境 simulation=False)
SJ_API_KEY=your_sinopac_api_key_here
SJ_SECRET_KEY=your_sinopac_secret_key_here
SHIOAJI_API_KEY=your_sinopac_api_key_here
SHIOAJI_SECRET_KEY=your_sinopac_secret_key_here
SHIOAJI_CERT_PATH=C:/path/to/Sinopac.pfx
SHIOAJI_CERT_PASSWORD=your_cert_password

# 3. FinMind 財經資料庫 (日K、三大法人、營收數據)
FINMIND_API_TOKEN=your_finmind_token_here

# 4. 富果 Fugle Marketdata API (備援行情來源)
FUGLE_API_TOKEN=your_fugle_marketdata_token_here

# 5. Google Gemini API (新聞情緒與重大訊息事件分類)
GEMINI_API_KEY=your_gemini_api_key_here

# 6. 系統伺服器設定
APP_PORT=8000
